# MariaDB connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_platform

# JWT signing secret - replace with a long random secret
JWT_SECRET=replace_with_a_long_random_secret

# Seed account passwords - set these before running seed
S_AD_SEED_PASSWORD=replace_with_super_admin_password
AD_SEED_PASSWORD=replace_with_admin_password

# Prisma datasource URL
DATABASE_URL=mysql://root:@localhost:3306/ecommerce_platform

# Backend server port
PORT=3000
